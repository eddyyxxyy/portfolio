---
import { Picture } from "astro:assets";

import heroImage from "@assets/hero_dark_decorative_image.svg";
import edsonPimentaImage from "@assets/Edson_Pimenta_Face_Picture.webp";
import clubeDaTransicaoImage from "@assets/project_pics/clube-da-transicao.webp";
import toDoListImage from "@assets/project_pics/todo-list.webp";
import coffeeDeliveryImage from "@assets/project_pics/coffee-delivery.webp";
import dailyDietApiImage from "@assets/project_pics/daily-diet-api.webp";
import toTempImage from "@assets/project_pics/to-temp.webp";
import schematicLdImage from "@assets/project_pics/schematic-ld.svg";
import granQuestoesImage from "@assets/project_pics/gran-questoes-home.webp";

import BaseLayout from "@layouts/BaseLayout.astro";
import CarouselIcons from "@/components/CarouselIcons.astro";
import Card from "@/components/Card.astro";
import ProfessionalExp from "@/components/ProfessionalExp.astro";
import InlineIcon from "@/components/InlineIcon.astro";

type Locale = "en" | "pt-br";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  en: {
    meta: {
      title: "Edson Pimenta | Growth Engineering & AI Systems",
      description:
        "Software engineer specializing in growth engineering and AI systems. Scaled organic platform revenue 5x with high-scale web architecture, PHP, TypeScript, Node.js, and LLM orchestration.",
    },
    hero: {
      eyebrow: "Hello, my name is",
      headline: "Growth and AI systems that scale revenue.",
      details: [
        "I design high-scale web architecture, product-led growth, and LLM orchestration.",
        "PHP, TypeScript, and Node.js, measured in revenue, indexation, and performance.",
      ],
    },
    about: {
      heading: "About me",
      imageAlt: "Edson Pimenta.",
      paragraphs: [
        "I treat organic growth as a systems problem: routing, structured data, performance, and UX decide whether a platform gets found and whether that traffic becomes revenue. At Gran Cursos, that work scaled organic platform revenue from under R$100k to over R$500k.",
        "The same constraint now applies to AI. Search engines and generative engines both need a clean, trustworthy content graph. I lead semantic deduplication of questions for Generative Engine Optimization, and I design agent and LLM orchestration with MCP and RAG on PHP with Symfony and Slim, TypeScript, and Node.js, on web architecture built for high scale. On the frontend, I work with React, Vue, and Nuxt, while favoring native web capabilities whenever they are the simplest reliable choice. I approach each initiative pragmatically, matching architecture to the product, maintenance, and market constraints.",
      ],
      stackHeading: "Tech stack",
      stack: [
        "PHP",
        "Symfony",
        "Slim",
        "TypeScript",
        "Node.js",
        "Python",
        "React",
        "Vue",
        "Nuxt",
        "AI systems: agents, MCP, RAG",
        "Distributed systems",
      ],
      socialLabels: {
        github: "Edson Pimenta's GitHub profile",
        linkedin: "Edson Pimenta's LinkedIn profile",
        youtube: "Edson Pimenta's YouTube channel",
        email: "Email Edson Pimenta",
      },
    },
    achievements: {
      heading: "Featured achievements",
      items: [
        "Scaled organic platform revenue at Gran Cursos from under R$100k to over R$500k (5x) by aligning product-led growth, performance, and UX.",
        "Shipped dynamic routing that kept 50,000+ URLs from being deindexed by Google.",
        "Built a JSON-LD library from scratch, tuned for Node's V8 engine and aligned with Google's structured-data requirements.",
        "Leading semantic deduplication of questions, preparing the catalog for Generative Engine Optimization (GEO).",
        "Audited the organic products and resolved 70+ security vulnerabilities.",
      ],
    },
    career: {
      heading: "Experience",
      lead: "With over 4 years of professional experience,",
      description:
        "I have worked on several projects as a freelancer and employee across different technologies and architectures. Maintaining proprietary and third-party systems, adding features, and fixing defects are part of my routine. Here I focus on my formal work experience.",
      jobs: [
        {
          title: "Software Engineer",
          where: "Gran",
          description:
            "Growth engineer on the organic platform at Gran, one of Latin America's largest edtech companies. Scaled organic revenue from under R$100k to over R$500k through product-led growth, performance, and UX. Built dynamic routing that kept 50,000+ URLs indexed, a JSON-LD library tuned for Node's V8, and the semantic deduplication that prepares the catalog for Generative Engine Optimization. The day-to-day stack is PHP, Symfony, Slim, TypeScript, Node.js, React, Vue, and Nuxt, deployed with Docker on AWS.",
          date: { from: "Aug 2025", to: "Present" },
          badges: [
            "PHP",
            "Symfony",
            "Slim",
            "TypeScript",
            "Node.js",
            "React",
            "Vue",
            "Nuxt",
            "Docker",
            "AWS",
          ],
          link: "https://www.grancursosonline.com.br/",
        },
        {
          title: "Full-Stack Web Developer",
          where: "Metropolitan Educação LTDA",
          description:
            "At a leading distance-learning company, owner of FAMEF, FAMEESP, and other institutions, I developed and improved web applications with PHP, CakePHP, Node.js, TypeScript, Next.js, GraphQL, and AWS. The work covered backend, frontend, and DevOps for internal systems, plus SEO analysis that improved the ranking of products open to students.",
          date: { from: "2023", to: "Apr 2024" },
          badges: [
            "PHP",
            "CakePHP",
            "Node.js",
            "TypeScript",
            "Next.js",
            "GraphQL",
            "REST",
            "AWS",
            "Docker",
            "jQuery",
          ],
          link: "https://www.faculdademetropolitana.edu.br/",
        },
      ],
    },
    projects: {
      heading: "Projects",
      schematic: {
        imageAlt:
          "SchematicLD pipeline from Schema.org entities to XSS-safe JSON-LD through V8-optimized objects.",
        content:
          "Private package owned by Gran that I designed and built: a zero-dependency JSON-LD library with monomorphic factories optimized for V8, XSS-safe serialization, and Google-compliant schemas. It powers structured data across Gran Questões without exposing proprietary source code.",
      },
      questions: {
        imageAlt:
          "Gran Questões homepage offering millions of free practice questions.",
        content:
          "High-scale study platform where I integrate SchematicLD into Nuxt SSR across the home page and pages for questions, exams, public-service exams, subjects, and mock exams. The integration builds consistent knowledge graphs for search and generative engines.",
      },
      transitionClub: {
        imageAlt: "Clube da Transição sustainability learning platform.",
        content:
          "Landing page that shares sustainability concepts through online lectures.",
      },
      todo: {
        imageAlt: "One More ToDo List task management interface.",
        content:
          "A simple web application to manage daily tasks with a modern interface.",
      },
      coffee: {
        imageAlt: "Coffee Delivery shopping cart interface.",
        content:
          "Responsive coffee shop storefront with English and Portuguese interfaces.",
      },
      diet: {
        imageAlt: "Daily Diet API project presentation.",
        content:
          "API for recording meals and tracking whether they fit a balanced routine.",
      },
      totemp: {
        imageAlt: "ToTemp Python temperature conversion package.",
        content:
          "Python package for representing, converting, calculating, and comparing temperatures.",
      },
    },
  },
  "pt-br": {
    meta: {
      title: "Edson Pimenta | Growth Engineering e Sistemas de IA",
      description:
        "Engenheiro de software especialista em growth engineering e sistemas de IA. Escalou a receita da plataforma orgânica em 5x com arquitetura web de alta escala, PHP, TypeScript, Node.js e orquestração de LLMs.",
    },
    hero: {
      eyebrow: "Olá, me chamo",
      headline: "Sistemas de growth e IA que escalam receita.",
      details: [
        "Desenho arquitetura web de alta escala, product-led growth e orquestração de LLMs.",
        "PHP, TypeScript e Node.js, medidos em receita, indexação e performance.",
      ],
    },
    about: {
      heading: "Sobre mim",
      imageAlt: "Edson Pimenta.",
      paragraphs: [
        "Trato growth orgânico como problema de sistema: roteamento, dados estruturados, performance e UX decidem se a plataforma é encontrada e se esse tráfego vira receita. No Gran Cursos, esse trabalho escalou o faturamento da plataforma orgânica de menos de R$ 100 mil para mais de R$ 500 mil.",
        "A mesma restrição agora vale para IA. Buscadores e motores generativos dependem de um grafo de conteúdo limpo e confiável. Lidero a deduplicação semântica de questões para GEO (Generative Engine Optimization) e desenho orquestração de agentes e LLMs com MCP e RAG, em PHP com Symfony e Slim, TypeScript e Node.js, sobre arquitetura web de alta escala. No frontend, trabalho com React, Vue e Nuxt, priorizando recursos nativos da web quando são a escolha mais simples e confiável. Ataco cada iniciativa com pragmatismo, alinhando a arquitetura às restrições de produto, manutenção e mercado.",
      ],
      stackHeading: "Stack",
      stack: [
        "PHP",
        "Symfony",
        "Slim",
        "TypeScript",
        "Node.js",
        "Python",
        "React",
        "Vue",
        "Nuxt",
        "Sistemas de IA: agentes, MCP, RAG",
        "Sistemas distribuídos",
      ],
      socialLabels: {
        github: "Perfil do GitHub de Edson Pimenta",
        linkedin: "Perfil do LinkedIn de Edson Pimenta",
        youtube: "Canal de Edson Pimenta no YouTube",
        email: "Enviar email para Edson Pimenta",
      },
    },
    achievements: {
      heading: "Conquistas",
      items: [
        "Escalei o faturamento da plataforma orgânica do Gran Cursos de menos de R$ 100 mil para mais de R$ 500 mil (5x), alinhando PLG, performance e UX.",
        "Entreguei roteamento dinâmico que impediu a desindexação de mais de 50 mil URLs pelo Google.",
        "Criei do zero uma biblioteca de JSON-LD ajustada ao motor V8 do Node e alinhada às exigências de dados estruturados do Google.",
        "Lidero a deduplicação semântica de questões, preparando o catálogo para GEO (Generative Engine Optimization).",
        "Conduzi a auditoria de segurança dos produtos orgânicos e resolvi mais de 70 vulnerabilidades.",
      ],
    },
    career: {
      heading: "Experiência profissional",
      lead: "Com mais de 4 anos de experiência profissional,",
      description:
        "trabalhei como freelancer e funcionário em projetos com diferentes tecnologias e arquiteturas. Manter sistemas proprietários e de terceiros, adicionar funcionalidades e corrigir defeitos fazem parte da minha rotina. Aqui destaco minhas experiências formais.",
      jobs: [
        {
          title: "Engenheiro de Software",
          where: "Gran",
          description:
            "Engenheiro de growth na plataforma orgânica do Gran, uma das maiores edtechs da América Latina. Escalei a receita orgânica de menos de R$ 100 mil para mais de R$ 500 mil com PLG, performance e UX. Construí o roteamento dinâmico que manteve mais de 50 mil URLs indexadas, uma biblioteca de JSON-LD ajustada ao V8 do Node e a deduplicação semântica que prepara o catálogo para Generative Engine Optimization. No dia a dia, a stack é PHP, Symfony, Slim, TypeScript, Node.js, React, Vue e Nuxt, com deploy em Docker na AWS.",
          date: { from: "Ago 2025", to: "Atual" },
          badges: [
            "PHP",
            "Symfony",
            "Slim",
            "TypeScript",
            "Node.js",
            "React",
            "Vue",
            "Nuxt",
            "Docker",
            "AWS",
          ],
          link: "https://www.grancursosonline.com.br/",
        },
        {
          title: "Desenvolvedor Web Full-Stack",
          where: "Metropolitan Educação LTDA",
          description:
            "Em uma empresa líder em educação a distância, proprietária da FAMEF, FAMEESP e outras instituições de ensino, desenvolvi e aprimorei aplicações web com PHP, CakePHP, Node.js, TypeScript, Next.js, GraphQL e AWS. Minha atuação se estendeu pelo backend, frontend e DevOps de aplicações internas, além da análise e aplicação de pesquisas de SEO para melhorar o ranqueamento dos produtos abertos a clientes e alunos.",
          date: { from: "2023", to: "Abr 2024" },
          badges: [
            "PHP",
            "CakePHP",
            "Node.js",
            "TypeScript",
            "Next.js",
            "GraphQL",
            "REST",
            "AWS",
            "Docker",
            "jQuery",
          ],
          link: "https://www.faculdademetropolitana.edu.br/",
        },
      ],
    },
    projects: {
      heading: "Projetos",
      schematic: {
        imageAlt:
          "Pipeline do SchematicLD, de entidades Schema.org a JSON-LD seguro contra XSS por meio de objetos otimizados para V8.",
        content:
          "Pacote privado, propriedade do Gran, que projetei e desenvolvi: uma biblioteca JSON-LD sem dependências, com factories monomórficas otimizadas para V8, serialização segura contra XSS e schemas alinhados ao Google. Sustenta os dados estruturados do Gran Questões sem expor código proprietário.",
      },
      questions: {
        imageAlt:
          "Home do Gran Questões, que oferece milhões de questões gratuitas para concursos.",
        content:
          "Plataforma de estudos em alta escala onde integro o SchematicLD ao SSR do Nuxt nas páginas de home, questões, provas, concursos, disciplinas e simulados. A integração forma grafos consistentes para buscadores e motores generativos.",
      },
      transitionClub: {
        imageAlt:
          "Plataforma de aprendizagem sobre sustentabilidade Clube da Transição.",
        content:
          "Landing page para difundir conceitos de sustentabilidade por meio de aulas online.",
      },
      todo: {
        imageAlt: "Interface de gerenciamento de tarefas One More ToDo List.",
        content:
          "Aplicação web simples para cuidar de tarefas diárias com uma interface moderna.",
      },
      coffee: {
        imageAlt: "Interface do carrinho de compras Coffee Delivery.",
        content:
          "Loja virtual responsiva de uma cafeteria fictícia, com interfaces em inglês e português.",
      },
      diet: {
        imageAlt: "Apresentação do projeto Daily Diet API.",
        content:
          "API para registrar refeições e acompanhar se elas fazem parte de uma rotina equilibrada.",
      },
      totemp: {
        imageAlt: "Pacote Python ToTemp para conversão de temperaturas.",
        content:
          "Pacote Python para representar, converter, calcular e comparar temperaturas.",
      },
    },
  },
};

const content = copy[locale];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout
  canonicalUrl={canonicalUrl}
  pageDescription={content.meta.description}
  pageTitle={content.meta.title}
>
  <main id="main-content">
    <div id="hero-blurry-background-container" aria-hidden="true">
      <div id="hero-blurry-background"></div>
    </div>
    <header id="hero">
      <div class="heroText">
        <p>{content.hero.eyebrow}</p>
        <h1>Edson Pimenta</h1>
        <p>{content.hero.headline}</p>
        <p class="heroDetails">
          {content.hero.details[0]}<br />
          {content.hero.details[1]}
        </p>
      </div>
      <div class="heroImage" aria-hidden="true">
        <img
          src={heroImage.src}
          alt=""
          width={heroImage.width}
          height={heroImage.height}
          loading="eager"
          decoding="async"
        />
      </div>
    </header>

    <div id="logo-carousel" aria-hidden="true">
      <div class="slide"><CarouselIcons /></div>
      <div class="slide"><CarouselIcons /></div>
    </div>

    <div class="intro">
      <section id="about" aria-labelledby="about-heading">
        <div class="content">
          <h2 id="about-heading">{content.about.heading}</h2>
          {content.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <h3>{content.about.stackHeading}</h3>
          <ul id="stack">
            {content.about.stack.map((technology) => <li>{technology}</li>)}
          </ul>
          <ul id="links" aria-label={content.about.socialLabels.github}>
            <li>
              <a
                href="https://github.com/eddyyxxyy"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={content.about.socialLabels.github}
                title="GitHub"
              >
                <InlineIcon name="github-logo" size={32} />
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/in/edsonrobertopimenta/"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={content.about.socialLabels.linkedin}
                title="LinkedIn"
              >
                <InlineIcon name="linkedin-logo" size={32} />
              </a>
            </li>
            <li>
              <a
                href="https://www.youtube.com/@eddyxide"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={content.about.socialLabels.youtube}
                title="YouTube"
              >
                <InlineIcon name="youtube-logo" size={32} />
              </a>
            </li>
            <li>
              <a
                href="mailto:dev.edsonpimenta@gmail.com"
                aria-label={content.about.socialLabels.email}
                title="Email"
              >
                <InlineIcon name="envelope" size={32} />
              </a>
            </li>
          </ul>
        </div>
      </section>

      <div class="image">
        <Picture
          src={edsonPimentaImage}
          alt={content.about.imageAlt}
          loading="lazy"
          decoding="async"
          format="webp"
          fallbackFormat="jpeg"
          layout="constrained"
        />
      </div>

      <section id="achievements" aria-labelledby="achievements-heading">
        <div class="content">
          <h2 id="achievements-heading">{content.achievements.heading}</h2>
          <ul>
            {
              content.achievements.items.map((achievement) => (
                <li>{achievement}</li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <section id="career" aria-labelledby="career-heading">
      <div class="content">
        <h2 id="career-heading">{content.career.heading}</h2>
        <p>
          <strong>{content.career.lead}</strong> {content.career.description}
        </p>
        {content.career.jobs.map((job) => <ProfessionalExp job={job} />)}
      </div>
    </section>

    <section id="projects" aria-labelledby="projects-heading">
      <div class="content">
        <h2 id="projects-heading">{content.projects.heading}</h2>
        <div id="projectsCards">
          <Card
            as="article"
            heading="SchematicLD"
            image={schematicLdImage}
            imageAlt={content.projects.schematic.imageAlt}
            content={content.projects.schematic.content}
            badges={["JavaScript", "JSON-LD", "Schema.org", "V8", "SEO/AEO"]}
          />
          <Card
            as="a"
            href="https://questoes.grancursosonline.com.br/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Gran Questões"
            image={granQuestoesImage}
            imageAlt={content.projects.questions.imageAlt}
            content={content.projects.questions.content}
            badges={["Vue", "Nuxt", "SSR", "JSON-LD", "GEO"]}
          />
          <Card
            as="a"
            href="https://ecovidapangeia.com/clube-da-transicao"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Clube da Transição - Ecovida Pangeia"
            image={clubeDaTransicaoImage}
            imageAlt={content.projects.transitionClub.imageAlt}
            content={content.projects.transitionClub.content}
            badges={["Astro", "TypeScript", "React", "Shadcn", "SSR", "Mailing"]}
          />
          <Card
            as="a"
            href="https://one-more-to-do-list.vercel.app/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="One More ToDo List"
            image={toDoListImage}
            imageAlt={content.projects.todo.imageAlt}
            content={content.projects.todo.content}
            badges={["React", "Vite", "TypeScript", "CSS Modules"]}
          />
          <Card
            as="a"
            href="https://coffee-delivery-eddyyxxyy.vercel.app/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Coffee Delivery"
            image={coffeeDeliveryImage}
            imageAlt={content.projects.coffee.imageAlt}
            content={content.projects.coffee.content}
            badges={["React", "Vite", "TypeScript", "Tailwind CSS", "i18next"]}
          />
          <Card
            as="a"
            href="https://github.com/eddyyxxyy/daily-diet-api"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Daily Diet API"
            image={dailyDietApiImage}
            imageAlt={content.projects.diet.imageAlt}
            content={content.projects.diet.content}
            badges={[
              "Node.js",
              "TypeScript",
              "Fastify",
              "PostgreSQL",
              "Knex",
              "Zod",
              "Vitest",
            ]}
          />
          <Card
            as="a"
            href="https://pypi.org/project/totemp/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="ToTemp"
            image={toTempImage}
            imageAlt={content.projects.totemp.imageAlt}
            content={content.projects.totemp.content}
            badges={["Python", "Metaprogramming", "OOP"]}
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  #hero-blurry-background-container,
  #career {
    background:
      radial-gradient(
        circle at bottom,
        rgba(35, 67, 85, 0.5),
        var(--neutral-100)
      ),
      url("/noise.svg");
  }

  #hero,
  .intro,
  #projects {
    background-image:
      linear-gradient(rgba(40, 163, 204, 0.05) 0.1em, transparent 0.1em),
      linear-gradient(90deg, rgba(40, 163, 204, 0.05) 0.1em, transparent 0.1em);
    background-size: 1.2rem 1.2rem;
  }

  #hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
    overflow: hidden;
  }

  #hero > * {
    max-width: 650px;
  }

  #hero-blurry-background-container {
    position: relative;
    display: flex;
    width: 100%;
    padding: 0;
  }

  #hero-blurry-background {
    z-index: -1;
    position: fixed;
    top: -250px;
    left: 0;
    width: 100%;
    min-height: 450px;
    background-image: radial-gradient(
      closest-side,
      rgba(40, 163, 204, 0.25),
      var(--neutral)
    );
  }

  .heroText :first-child {
    margin-bottom: 1.2rem;
    color: var(--neutral-700);
    font-size: 2rem;
  }

  .heroText :not(:first-child, h1) {
    font-size: clamp(2.2rem, 1.7294rem + 2.3529vw, 3.2rem);
  }

  .heroText > p:nth-of-type(2) {
    text-wrap: balance;
  }

  .heroText > h1 {
    width: fit-content;
    margin-bottom: 1.2rem;
    border-bottom: 3px solid var(--neutral-100);
    border-radius: 4px;
    background: linear-gradient(
      to top left,
      var(--neutral-900),
      var(--primary)
    );
    background-clip: text;
    color: var(--primary-100);
    font-family: var(--font-exo-2);
    font-size: clamp(3.2rem, 2.9176rem + 1.4118vw, 3.8rem);
    text-transform: uppercase;
    white-space: nowrap;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .heroText > .heroDetails {
    color: var(--neutral-700);
    font-size: 2.4rem;
  }

  .heroImage {
    width: 100%;
    max-width: 450px;
  }

  .heroImage img {
    width: 100%;
    height: 100%;
  }

  #logo-carousel {
    position: relative;
    display: flex;
    align-items: center;
    overflow-x: hidden;
    background-color: var(--neutral-100);
    white-space: nowrap;
  }

  #logo-carousel::before,
  #logo-carousel::after {
    z-index: 1;
    position: absolute;
    top: 0;
    width: 12rem;
    height: 100%;
    content: "";
  }

  #logo-carousel::before {
    left: 0;
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 0),
      var(--neutral-100)
    );
  }

  #logo-carousel::after {
    right: 0;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0),
      var(--neutral-100)
    );
  }

  #logo-carousel:hover .slide {
    animation-play-state: paused;
  }

  .slide {
    display: flex;
    align-items: center;
    justify-content: center;
