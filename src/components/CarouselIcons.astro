---
import InlineIcon from "./InlineIcon.astro";

const technologies = [
  "linux-icon",
  "git-icon",
  "docker-icon",
  "nginx-icon",
  "aws-icon",
  "graphql-icon",
  "cakephp-icon",
  "php-icon",
  "symfony-icon",
  "slim-icon",
  "nodejs-icon",
  "html5-icon",
  "css3-icon",
  "javascript-icon",
  "typescript-icon",
  "astro-icon",
  "react-icon",
  "vue-icon",
  "nuxt-icon",
  "nextjs-icon",
  "tailwindjs-icon",
  "prismajs-icon",
  "knexjs-icon",
  "fastify-icon",
  "express-icon",
  "mysql-icon",
  "postgresql-icon",
  "mongodb-icon",
  "python-icon",
];
---

<div class="icons">
  {
    technologies.map((technology) => (
      <InlineIcon class="technology-icon" name={technology} />
    ))
  }
</div>

<style>
  .icons {
    display: flex;
    align-items: center;
  }

  .icons :global(.technology-icon) {
    width: 6.4rem;
    height: 6.4rem;
    margin: 0 4rem;
    color: var(--neutral-700);
    fill: currentColor;
  }

  @media (min-width: 1000px) {
    .icons :global(.technology-icon) {
      width: 8.2rem;
      height: 8.2rem;
    }
  }
</style>
