---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Picture } from "astro:assets";

import logoColoured from "@assets/logo_coloured.webp";
import { translationsHeader } from "@i18n/Header";
import navigationSource from "@/client/navigation.js?raw";
import InlineIcon from "./InlineIcon.astro";
import NavigationMenu from "./NavigationMenu.astro";

const currentLang = Astro.currentLocale === "en" ? "en" : "pt-br";

const translationObject = translationsHeader[currentLang];
const navigationScript = navigationSource;
---

<header>
  <a href={getRelativeLocaleUrl(Astro.currentLocale ?? "en", "/")} class="logo">
    <div class="logoImg">
      <Picture
        src={logoColoured}
        alt={translationObject.logoAlt}
        loading="eager"
        decoding="async"
        format="webp"
        fallbackFormat="jpg"
        layout="fixed"
        width={30}
        height={30}
      />
    </div>
    <span>EDDY<span>YXXYY</span></span>
  </a>
  <button
    type="button"
    id="menu-toggle"
    popovertarget="mobile-menu"
    aria-label={translationObject.menuToggle}
  >
    <InlineIcon name="hamburguer_menu" size={18} />
  </button>
  <nav
    id="mobile-menu"
    class="mobile-menu"
    aria-label={translationObject.navigationLabel}
    popover
  >
    <NavigationMenu idPrefix="mobile" />
  </nav>
  <nav class="desktop-menu" aria-label={translationObject.navigationLabel}>
    <NavigationMenu idPrefix="desktop" />
  </nav>
</header>

<script is:inline set:html={navigationScript} />

<style>
  header {
    z-index: 2;
    position: fixed;
    height: 6rem;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--neutral);
    padding: 1rem 2rem;
    border-bottom: 1px solid var(--neutral-100);
    box-shadow: rgba(0, 0, 0, 0.15) 0px 3px 3px 0px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    padding: 0.4rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--primary) 50%, transparent);
    border-radius: 8px;
    transition:
      0.25s border ease-in-out,
      0.25s filter cubic-bezier(0.075, 0.82, 0.165, 1);
  }

  .logo:hover,
  .logo:focus-visible {
    filter: brightness(1.1);
    border-color: var(--focus);
  }

  .logo span {
    font-family: var(--font-exo-2);
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 3rem;
    color: var(--neutral-900);
    text-decoration: underline transparent;
    transition: 0.2s text-decoration ease-in-out;
  }

  .logo:hover > span,
  .logo:focus-visible > span {
    text-decoration: underline var(--neutral-600);
  }

  .logo span > span {
    color: var(--neutral-600);
  }

  .logoImg {
    height: 3rem;
    width: 3rem;
  }

  .logoImg img {
    height: 100%;
    width: 100%;
  }

  button {
    display: flex;
    padding: 0.4rem;
    margin: 0.7rem 0px 0.7rem;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    transition: 0.25s border cubic-bezier(0.075, 0.82, 0.165, 1);
  }

  button:hover,
  button:focus-visible {
    filter: brightness(1.2);
    border-color: var(--focus);
  }

  #menu-toggle :global(.inline-icon) {
    color: var(--neutral-900);
  }

  .desktop-menu {
    display: none;
  }

  .mobile-menu {
    position: fixed;
    inset: 6rem 0 auto auto;
    width: min(32rem, 100%);
    max-height: calc(100dvh - 6rem);
    padding: 0.8rem 2rem;
    margin: 0;
    overflow: auto;
    border: 0 1px 1px 1px solid var(--neutral-100);
    border-top: none;
    border-radius: 0 0 0 8px;
    background-color: var(--neutral);
    text-align: left;
    box-shadow: 0 12px 16px -10px rgba(0, 0, 0, 0.28);
  }

  .mobile-menu:popover-open {
    display: block;
    z-index: 1;
  }

  .mobile-menu::backdrop {
    background-color: rgba(0, 0, 0, 0.15);
    clip-path: inset(6rem 0 0 0);
  }

  @media (min-width: 1000px) {
    header {
      padding: 1rem 12%;
    }

    .logo span {
      font-size: 1.8rem;
    }

    .desktop-menu {
      display: block;
      width: 100%;
    }

    #menu-toggle,
    .mobile-menu {
      display: none;
    }

    #mobile-menu:popover-open {
      display: none;
    }

    #menu-toggle :global(.inline-icon) {
      display: none;
      width: 0;
      height: 0;
    }

  }

  @media (min-width: 1280px) {
    header {
      padding: 1rem 18%;
    }
  }
</style>
