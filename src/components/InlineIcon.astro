---
interface Props {
  class?: string;
  name: string;
  size?: number;
}

const { class: className, name, size } = Astro.props;
const icons = import.meta.glob<string>("../icons/*.svg", {
  eager: true,
  import: "default",
  query: "?raw",
});
const source = icons[`../icons/${name}.svg`];

if (!source) {
  throw new Error(`Unknown local icon: ${name}`);
}
---

<span
  aria-hidden="true"
  class:list={["inline-icon", className, size && `size-${size}`]}
  set:html={source}
></span>

<style>
  .inline-icon {
    display: inline-flex;
    flex: none;
    width: 1em;
    height: 1em;
    line-height: 1;
  }

  .inline-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .size-12 {
    font-size: 1.2rem;
  }

  .size-14 {
    font-size: 1.4rem;
  }

  .size-18 {
    font-size: 1.8rem;
  }

  .size-32 {
    font-size: 3.2rem;
  }
</style>
