---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";

import heroImage from "@assets/hero_dark_decorative_image.svg";
import edsonPimentaImage from "@assets/Edson_Pimenta_Face_Picture.webp";
import clubeDaTransicaoImage from "@assets/project_pics/clube-da-transicao.webp";
import toDoListImage from "@assets/project_pics/todo-list.webp";
import coffeeDeliveryImage from "@assets/project_pics/coffee-delivery.webp";
import dailyDietApiImage from "@assets/project_pics/daily-diet-api.webp";
import toTempImage from "@assets/project_pics/to-temp.webp";
import schematicLdImage from "@assets/project_pics/schematic-ld.svg";
import granQuestoesImage from "@assets/project_pics/gran-questoes-home.png";

import BaseLayout from "@layouts/BaseLayout.astro";
import CarouselIcons from "@/components/CarouselIcons.astro";
import Card from "@/components/Card.astro";
import ProfessionalExp from "@/components/ProfessionalExp.astro";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout
  canonicalUrl={canonicalUrl}
  pageDescription="Software engineer specializing in growth engineering and AI systems. Scaled organic platform revenue 5x with high-scale web architecture, PHP, TypeScript, Node.js, and LLM orchestration."
  pageTitle="Edson Pimenta | Growth Engineering & AI Systems"
>
  <main>
    <div id="hero-blurry-background-container">
      <div id="hero-blurry-background"></div>
    </div>
    <header id="hero">
      <div class="heroText">
        <p>Hello, my name is</p>
        <h1>Edson Pimenta</h1>
        <p>Growth and AI systems that scale revenue.</p>
        <p>
          <span
            >I design high-scale web architecture, product-led growth, and LLM
            orchestration.<br />
            PHP, TypeScript, and Node.js, measured in revenue, indexation, and
            performance.</span
          >
        </p>
      </div>
      <div class="heroImage">
        <Picture
          src={heroImage}
          alt=""
          loading="eager"
          decoding="async"
          format="svg"
          fallbackFormat="png"
        />
      </div>
    </header>
    <div id="logo-carousel">
      <div class="slide">
        <CarouselIcons />
      </div>
      <div class="slide">
        <CarouselIcons />
      </div>
    </div>
    <section id="about">
      <div class="image">
        <Picture
          src={edsonPimentaImage}
          alt="Edson Pimenta's face."
          loading="lazy"
          decoding="async"
          format="webp"
          fallbackFormat="jpeg"
        />
      </div>
      <div class="content">
        <h2>About me</h2>
        <p>
          I treat organic growth as a systems problem: routing, structured
          data, performance, and UX decide whether a platform gets found and
          whether that traffic becomes revenue. At Gran Cursos, that work
          scaled organic platform revenue from under R$100k to over R$500k.
        </p>
        <p>
          The same constraint now applies to AI. Search engines and generative
          engines both need a clean, trustworthy content graph. I lead semantic
          deduplication of questions for Generative Engine Optimization, and I
          design agent and LLM orchestration with MCP and RAG on PHP with
          Symfony and Slim, TypeScript, and Node.js, on web architecture built
          for high scale. On the frontend, I work with React, Vue, and Nuxt,
          while favoring native web capabilities whenever they are the simplest
          reliable choice. I approach each initiative pragmatically, matching
          architecture to the product, maintenance, and market constraints.
        </p>
        <h3>Tech stack</h3>
        <ul id="stack">
          <li>PHP</li>
          <li>Symfony</li>
          <li>Slim</li>
          <li>TypeScript</li>
          <li>Node.js</li>
          <li>Python</li>
          <li>React</li>
          <li>Vue</li>
          <li>Nuxt</li>
          <li>AI systems: agents, MCP, RAG</li>
          <li>Distributed systems</li>
        </ul>

        <ul id="links">
          <li>
            <a
              href="https://github.com/eddyyxxyy"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Edson's Github profile page"
              title="Github"
            >
              <Icon name="github-logo" size={32} />
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/edsonrobertopimenta/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Edson's LinkedIn profile page"
              title="LinkedIn"
            >
              <Icon name="linkedin-logo" size={32} />
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@eddyxide"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Edson's Youtube channel"
              title="Youtube"
            >
              <Icon name="youtube-logo" size={32} />
            </a>
          </li>
          <li>
            <a
              href="mailto:dev.edsonpimenta@gmail.com"
              aria-label="Edson's E-mail"
              title="E-mail"
            >
              <Icon name="envelope" size={32} />
            </a>
          </li>
        </ul>
      </div>
    </section>
    <section id="achievements">
      <div class="content">
        <h2>Featured achievements</h2>
        <ul>
          <li>
            Scaled organic platform revenue at Gran Cursos from under R$100k to
            over R$500k (5x) by aligning product-led growth, performance, and
            UX.
          </li>
          <li>
            Shipped dynamic routing that kept 50,000+ URLs from being deindexed
            by Google.
          </li>
          <li>
            Built a JSON-LD library from scratch, tuned for Node's V8 engine and
            aligned with Google's structured-data requirements.
          </li>
          <li>
            Leading semantic deduplication of questions, preparing the catalog
            for Generative Engine Optimization (GEO).
          </li>
          <li>
            Audited the organic products and resolved 70+ security
            vulnerabilities.
          </li>
        </ul>
      </div>
    </section>
    <section id="career">
      <div class="content">
        <h2>Experience</h2>
        <p>
          With <strong>over 4 years of professional experience</strong>, I have
          worked on several projects as a freelancer and employee using a
          <strong>variety of technologies and architectures</strong>.
          Maintaining, adding features, and fixing bugs in proprietary and
          third-party
          systems is part of my routine. Here I focus on my formal work
          experience.
        </p>
        <ProfessionalExp
          job={{
            title: "Software Engineer",
            where: "Gran",
            description:
              "Growth engineer on the organic platform at Gran, one of Latin America's largest edtech companies. Scaled organic revenue from under R$100k to over R$500k through product-led growth, performance, and UX. Built dynamic routing that kept 50,000+ URLs indexed, a JSON-LD library tuned for Node's V8, and the semantic deduplication that prepares the catalog for Generative Engine Optimization. The day-to-day stack is PHP, Symfony, Slim, TypeScript, Node.js, React, Vue, and Nuxt, deployed with Docker on AWS.",
            date: {
              from: "Aug 2025",
              to: "Present",
            },
            badges: [
              "PHP",
              "Symfony",
              "Slim",
              "TypeScript",
              "Node.js",
              "React",
              "Vue",
              "Nuxt",
              "Docker",
              "AWS",
            ],
            link: "https://www.grancursosonline.com.br/",
          }}
        />
        <ProfessionalExp
          job={{
            title: "FullStack Web Developer",
            where: "Metropolitan Educação LTDA",
            description:
              "At a leading distance-learning company, owner of FAMEF, FAMEESP, and other institutions, I developed and improved web applications with PHP, CakePHP, Node.js, TypeScript, Next.js, GraphQL, and AWS. The work covered backend, frontend, and DevOps for internal systems, plus SEO analysis that improved the ranking of products open to students.",
            date: {
              from: "2023",
              to: "Apr 2024",
            },
            badges: [
              "PHP",
              "CakePHP",
              "NodeJs",
              "TypeScript",
              "NextJs",
              "GraphQL",
              "Rest",
              "AWS",
              "Docker",
              "JQuery",
            ],
            link: "https://www.faculdademetropolitana.edu.br/",
          }}
        />
      </div>
    </section>
    <section id="projects">
      <div class="content">
        <h2>Projects</h2>
        <div id="projectsCards">
          <Card
            as="article"
            heading="SchematicLD"
            image={schematicLdImage}
            imageAlt="SchematicLD pipeline from Schema.org entities to XSS-safe JSON-LD through V8-optimized objects."
            content="Private package owned by Gran that I designed and built: a zero-dependency JSON-LD library with monomorphic factories optimized for V8, XSS-safe serialization, and Google-compliant schemas. It powers structured data across Gran Questões without exposing proprietary source code."
            badges={[
              "JavaScript",
              "JSON-LD",
              "Schema.org",
              "V8",
              "SEO/AEO",
            ]}
          />
          <Card
            as="a"
            href="https://questoes.grancursosonline.com.br/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Gran Questões"
            image={granQuestoesImage}
            imageAlt="Gran Questões homepage offering millions of free practice questions."
            content="High-scale study platform where I integrate SchematicLD into Nuxt SSR across the home, question, exam, contest, subject, and simulation pages. It builds consistent knowledge graphs for search and generative engines."
            badges={["Vue", "Nuxt", "SSR", "JSON-LD", "GEO"]}
          />
          <Card
            as="a"
            href="https://ecovidapangeia.com/clube-da-transicao"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Clube da Transição - Ecovida Pangeia"
            image={clubeDaTransicaoImage}
            imageAlt="Clube da Transição sustainability learning platform."
            content="Landing page that shares sustainability concepts through online lectures."
            badges={[
              "Astro",
              "TypeScript",
              "ReactJs",
              "Shadcn",
              "SSR",
              "Mailing",
            ]}
          />
          <Card
            as="a"
            href="https://one-more-to-do-list.vercel.app/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="One More ToDo List"
            image={toDoListImage}
            imageAlt="One More ToDo List task management interface."
            content="A simple web application to manage your daily tasks with a modern and pleasing UI."
            badges={["ReactJs", "Vite", "TypeScript", "CSS Modules"]}
          />
          <Card
            as="a"
            href="https://coffee-delivery-eddyyxxyy.vercel.app/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Coffee Delivery"
            image={coffeeDeliveryImage}
            imageAlt="Coffee Delivery shopping cart interface."
            content="Web application that simulates a coffee shop storefront, with English and Portuguese interfaces."
            badges={["ReactJs", "Vite", "TypeScript", "TailwindCSS", "i18next"]}
          />
          <Card
            as="a"
            href="https://github.com/eddyyxxyy/daily-diet-api"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="Daily Diet API"
            image={dailyDietApiImage}
            imageAlt="Daily Diet API project presentation."
            content="API for notes and reminders about meals and diet, built to support a balanced routine."
            badges={[
              "NodeJS",
              "TypeScript",
              "Fastify",
              "PostgreSQL",
              "Knex",
              "Zod",
              "Vitest",
            ]}
          />
          <Card
            as="a"
            href="https://pypi.org/project/totemp/"
            target="_blank"
            rel="nofollow noopener noreferrer"
            heading="ToTemp"
            image={toTempImage}
            imageAlt="ToTemp Python temperature conversion package."
            content="Python package for representing temperature scales and converting, calculating, and comparing them with other temperatures and numbers."
            badges={["Python", "MetaProgramming", "OOP"]}
          />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main > :nth-child(odd):not(#logo-carousel) {
    background:
      radial-gradient(
        circle at bottom,
        rgba(35, 67, 85, 0.5),
        var(--neutral-100)
      ),
      url(/noise.svg);
  }

  main > :nth-child(even) {
    background-image:
      linear-gradient(rgba(40, 163, 204, 0.05) 0.1em, transparent 0.1em),
      linear-gradient(90deg, rgba(40, 163, 204, 0.05) 0.1em, transparent 0.1em);
    background-size: 1.2rem 1.2rem;
  }

  #hero > * {
    max-width: 650px;
  }

  #hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
    overflow: hidden;
  }

  #hero-blurry-background-container {
    position: relative;
    display: flex;
    width: 100%;
    padding: 0;
  }

  #hero-blurry-background {
    z-index: -1;
    position: fixed;
    flex: 1;
    top: -250px;
    left: 0;
    width: 100%;
    min-height: 450px;
    background-image: radial-gradient(
      closest-side,
      rgba(40, 163, 204, 0.25),
      var(--neutral)
    );
  }

  .heroText :first-child {
    font-size: 2rem;
    color: var(--neutral-700);
    margin-bottom: 1.2rem;
  }

  .heroText :not(:first-child, h1) {
    font-size: clamp(2.2rem, 1.7294rem + 2.3529vw, 3.2rem);
  }

  .heroText > p:nth-of-type(2) {
    text-wrap: balance;
  }

  .heroText p span {
    color: var(--neutral-700);
    font-size: clamp(2rem, 1.6235rem + 1.8824vw, 2.8rem);
  }

  .heroText > h1 {
    background: linear-gradient(
      to top left,
      var(--neutral-900),
      var(--primary)
    );
    background-clip: border-box;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    width: fit-content;
    font-family: "Exo 2", serif;
    font-size: clamp(3.2rem, 2.9176rem + 1.4118vw, 3.8rem);
    text-transform: uppercase;
    color: var(--primary-100);
    border-bottom: 3px solid var(--neutral-100);
    border-radius: 4px;
    margin-bottom: 1.2rem;
    white-space: nowrap;
  }

  .heroImage {
    max-width: 450px;
    width: 100%;
  }

  .heroImage img {
    width: 100%;
    height: 100%;
  }

  #logo-carousel {
    position: relative;
    display: flex;
    align-items: center;
    overflow-x: hidden;
    white-space: nowrap;
    background-color: var(--neutral-100);
  }

  #logo-carousel::before,
  #logo-carousel::after {
    z-index: 1;
    position: absolute;
    top: 0;
    width: 12rem;
    height: 100%;
    content: "";
  }

  #logo-carousel::before {
    left: 0;
    background: linear-gradient(
      to left,
      rgba(255, 255, 255, 0),
      var(--neutral-100)
    );
  }

  #logo-carousel::after {
    right: 0;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0),
      var(--neutral-100)
    );
  }

  #logo-carousel:hover .slide {
    animation-play-state: paused;
  }

  .slide {
    display: flex;
    align-items: center;
    justify-content: center;
    animation: 60s slide infinite linear;
  }

  section {
    scroll-margin-top: 6rem;
  }

  section h2 {
    font-size: 2.8rem;
    color: var(--neutral-700);
  }

  #about,
  #achievements,
  #career,
  #projects {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    justify-content: center;
    gap: 4rem;
  }

  .content h3 {
    margin-top: 3.2rem;
    color: var(--neutral-700);
    font-family: "Exo 2", sans-serif;
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
    list-style: none;
  }

  #stack li {
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--neutral-700);
    border-radius: 8px;
    color: var(--neutral-900);
    font-size: 1.6rem;
  }

  #achievements ul {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    margin-top: 2.4rem;
    list-style: none;
  }

  #achievements li {
    padding-left: 1.6rem;
    border-left: 3px solid var(--primary);
    color: var(--neutral-800);
    font-size: 2rem;
  }

  #about .image {
    max-width: 350px;
    height: 100%;
  }

  #about img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    box-shadow:
      var(--neutral-600) -3px 3px,
      var(--neutral-500) -6px 6px,
      var(--neutral-400) -9px 9px,
      var(--neutral-300) -12px 12px,
      var(--neutral-200) -15px 15px;
  }

  .content {
    width: 100%;
    max-width: 650px;
    margin-bottom: 2rem;
  }

  .content :is(p, strong) {
    font-size: 2rem;
    margin-top: 2rem;
  }

  #projectsCards {
    display: grid;
    gap: 1.4rem;
  }

  #links {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: start;
    gap: 2.4rem;
    list-style: none;
    margin-top: 2.4rem;
  }

  #links a {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 0.4rem;
    background-color: var(--neutral-100);
    padding: 1.2rem;
    border-radius: 12px;
    transition: filter 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  #links a:is(:hover, :focus) {
    filter: brightness(1.1);
  }

  @keyframes slide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }

  @media (min-width: 1000px) {
    #hero > * {
      max-width: 100%;
    }

    #hero {
      flex-direction: row;
      gap: 8rem;
    }

    .heroText :first-child {
      font-size: 2rem;
      color: var(--neutral-700);
      margin-bottom: 2rem;
    }

    .heroText :not(:first-child, h1) {
    }

    .heroText > h1 {
      font-size: 4.8rem;
      margin-bottom: 1.2rem;
    }

    .heroText {
      max-width: 100%;
    }

    .heroImage {
      width: 100%;
    }

    #logo-carousel::before,
    #logo-carousel::after {
      width: 25rem;
    }

    #about {
      flex-direction: row;
      align-items: start;
      gap: 8rem;
    }

    #about .image {
      max-width: 300px;
      min-width: 300px;
    }

    .content {
      width: 100%;
      max-width: initial;
    }

    #links {
      display: flex;
    }

    #projects {
      align-items: start;
    }

    #projectsCards {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.8rem;
    }
  }

  @media (min-width: 1280px) {
    .heroText :first-child {
      font-size: 2.4rem;
      color: var(--neutral-700);
      margin-bottom: 2.4rem;
    }

    .heroText :not(:first-child, h1) {
      font-size: 3.2rem;
    }

    .heroText > h1 {
      font-size: 5.4rem;
      margin-bottom: 1.2rem;
    }

    .content :is(p, strong),
    #achievements li {
      font-size: 2.2rem;
    }
  }

</style>
